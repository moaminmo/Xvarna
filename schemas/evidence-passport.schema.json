{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xvarna.org/schemas/evidence-passport.schema.json",
  "title": "XVARNA RASHNU Evidence Passport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resultHash", "sceneHash", "method", "fidelity", "engineVersion", "backend", "generatedUtc", "contentHash"],
  "properties": {
    "schemaVersion": { "const": "xvarna.evidence-passport/1" },
    "resultHash": { "type": "string", "minLength": 1 },
    "sceneHash": { "type": "string", "minLength": 1 },
    "studyId": { "type": "string" },
    "variantId": { "type": ["integer", "null"], "minimum": 0 },
    "method": { "type": "string", "minLength": 1 },
    "fidelity": { "enum": ["fast", "reference"] },
    "engineVersion": { "type": "string", "minLength": 1 },
    "backend": { "type": "string", "minLength": 1 },
    "device": { "type": "string" },
    "driver": { "type": "string" },
    "generatedUtc": { "type": "string", "format": "date-time" },
    "seed": { "type": ["integer", "null"], "minimum": 0 },
    "sampleCount": { "type": "integer", "minimum": 0 },
    "convergenceDelta": { "type": ["number", "null"], "minimum": 0 },
    "elapsedMicroseconds": { "type": "integer", "minimum": 0 },
    "inputHashes": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "citations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "validation": { "$ref": "#/$defs/validation" },
    "contentHash": { "type": "string" }
  },
  "$defs": {
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parityTested", "referenceTested"],
      "properties": {
        "parityTested": { "type": "boolean" },
        "maximumParityDelta": { "type": ["number", "null"], "minimum": 0 },
        "referenceTested": { "type": "boolean" },
        "referenceMethod": { "type": "string" },
        "maximumReferenceError": { "type": ["number", "null"], "minimum": 0 },
        "acceptedFraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    }
  }
}
